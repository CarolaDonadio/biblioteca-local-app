CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8081/'
app.forceGlobalSecureRequests = false
app.CSPEnabled = false

database.default.hostname = db
database.default.database = biblioteca_virtual
database.default.username = biblioteca
database.default.password = biblioteca
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

encryption.key = docker-local-development-key-32

session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.savePath = /var/www/html/writable/session

logger.threshold = 4
